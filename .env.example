# Database
DATABASE_URL=""

# Platform
# Public base URL of the deployment. Its port also drives the dev server,
# which vite.config.ts parses out of this value.
PUBLIC_BASE_URL="http://localhost:8001"

# Auth (better-auth)
# Use 32 characters generated with high entropy in production.
BETTER_AUTH_SECRET=""

# Google OAuth
# Authorized redirect URI: <PUBLIC_BASE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email
# Sends through the Postmark API, so EMAIL_HOST stays blank here.
# Leave EMAIL_TOKEN blank in dev to stub sends to the console.
EMAIL_HOST=""
EMAIL_TOKEN=""
EMAIL_FROM="noreply@vote.ke"
EMAIL_ADMIN="techytimo@gmail.com"
EMAIL_TO=""
EMAIL_BCC=""

# Payments (Paystack)
# Blank runs a mock instant-success charge in dev.
PAYSTACK_SECRET_KEY=""

# SMS (Africa's Talking)
# Blank stubs sends to the console. Username "sandbox" routes to the free
# sandbox host, which the app derives from the username.
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
AFRICASTALKING_SENDER_ID=""

# AI chat (Anthropic)
# Blank falls back to keyword-match answers.
ANTHROPIC_API_KEY=""

# Object storage
# S3-compatible. Blank falls back to the local uploads directory.
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""
STORAGE_LOCAL_DIR=".uploads"

# Analytics (Vowsey)
# Public write key and host. Blank disables tracking.
PUBLIC_VOWSEY_KEY=""
PUBLIC_VOWSEY_HOST=""

# News ingest
# Blank leaves the scheduled ingest off.
NEWS_INGEST=""

# Demo login
# Prefills the login form in dev and seeds the system admin account.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD="dm.2026#"
